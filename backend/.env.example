# Server
PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://rafiq_user:rafiq_password@localhost:5432/rafiq_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
